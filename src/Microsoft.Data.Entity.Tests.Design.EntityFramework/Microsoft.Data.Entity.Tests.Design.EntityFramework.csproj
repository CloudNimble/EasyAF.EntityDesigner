<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net48;net10.0</TargetFrameworks>
    <RuntimeIdentifier></RuntimeIdentifier>
    <!-- Directory.Build.props flattens output, which collides when multi-targeting. -->
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
    <RootNamespace>Microsoft.Data.Entity.Tests.Design.EntityFramework</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Data" />
    <Reference Include="System.Data.Entity" />
    <Reference Include="System.Xml.Linq" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="EntityFramework" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Microsoft.Data.Entity.Design.EntityFramework\Microsoft.Data.Entity.Design.EntityFramework.csproj" />
  </ItemGroup>

  <!-- Publicize EntityFramework internals at compile-time -->
  <ItemGroup>
    <PackageReference Include="Krafs.Publicizer" PrivateAssets="all" />
    <Publicize Include="EntityFramework" />
  </ItemGroup>

</Project>
