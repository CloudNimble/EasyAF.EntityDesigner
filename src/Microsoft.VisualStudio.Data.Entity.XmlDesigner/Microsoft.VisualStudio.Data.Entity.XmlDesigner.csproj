<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Microsoft.VisualStudio.Data.Entity.XmlDesigner</RootNamespace>
    <AssemblyName>Microsoft.VisualStudio.Data.Entity.XmlDesigner</AssemblyName>
    <TargetFrameworks>net48</TargetFrameworks>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <NoWarn>$(NoWarn);VSTHRD010;VSTHRD001;VSSDK006</NoWarn>
    <ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>None</ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Accessibility" />
    <Reference Include="WindowsFormsIntegration" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Internal.VisualStudio.Interop" />
    <PackageReference Include="Microsoft.VisualStudio.Interop" />
    <PackageReference Include="Microsoft.VisualStudio.Modeling.Sdk" />
    <PackageReference Include="Microsoft.VisualStudio.Modeling.Sdk.Diagrams" />
    <PackageReference Include="Microsoft.VisualStudio.Modeling.Sdk.Diagrams.GraphObject" />
    <PackageReference Include="Microsoft.VisualStudio.Modeling.Sdk.Shell" />
    <PackageReference Include="Microsoft.VisualStudio.Package.LanguageService.15.0" />
    <PackageReference Include="Microsoft.VisualStudio.Shell.15.0" />
    <PackageReference Include="Microsoft.VisualStudio.Shell.Design" />
    <PackageReference Include="Microsoft.VisualStudio.Shell.Framework" />
    <PackageReference Include="Microsoft.VisualStudio.Threading" />
    <PackageReference Include="Microsoft.VisualStudio.XmlEditor" />
    <PackageReference Include="Microsoft.VSDesigner" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Microsoft.Data.Entity.Design.XmlEngine\Microsoft.Data.Entity.Design.XmlEngine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="XmlDesignerResources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>XmlDesignerResources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="UI\ViewModels\PropertyWindow\Converters\ControlsXmlDesignerResources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>ControlsXmlDesignerResources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="VisualStudio\UI\ProgressDialog.resx">
      <DependentUpon>ProgressDialog.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="VirtualTreeGrid\UI\VirtualTreeControl.resx">
      <!-- Must match the literal in VirtualTreeStrings.ResourceManager, which names VirtualTreeControl's namespace. -->
      <LogicalName>Microsoft.VisualStudio.Data.Entity.XmlDesigner.VirtualTreeGrid.UI.VirtualTreeControl.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="VirtualTreeGrid\Resources\arrow.ico">
      <!-- No .UI segment: loaded via new Icon(typeof(TypeEditorHost), ...), which resolves against TypeEditorHost's namespace. -->
      <LogicalName>Microsoft.VisualStudio.Data.Entity.XmlDesigner.VirtualTreeGrid.arrow.ico</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="VirtualTreeGrid\Resources\dotdotdot.ico">
      <LogicalName>Microsoft.VisualStudio.Data.Entity.XmlDesigner.VirtualTreeGrid.dotdotdot.ico</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- InternalsVisibleTo for projects that need access to internal types -->
  <ItemGroup>
    <InternalsVisibleTo Include="Microsoft.VisualStudio.Data.Entity.EdmxDesigner, $(StrongNamePublicKey)" />
    <InternalsVisibleTo Include="Microsoft.VisualStudio.Data.Entity.Package, $(StrongNamePublicKey)" />
    <InternalsVisibleTo Include="Microsoft.Data.Entity.Design.Diagrams, $(StrongNamePublicKey)" />
    <!-- Test projects -->
    <InternalsVisibleTo Include="Microsoft.Data.Entity.Tests.Design, $(StrongNamePublicKey)" />
    <InternalsVisibleTo Include="Microsoft.Data.Entity.Tests.Design.Diagrams, $(StrongNamePublicKey)" />
    <InternalsVisibleTo Include="Microsoft.VisualStudio.Data.Entity.Tests.Package, $(StrongNamePublicKey)" />
    <InternalsVisibleTo Include="Microsoft.VisualStudio.Data.Entity.Tests.XmlDesigner, $(StrongNamePublicKey)" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="XmlDesignerResources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>XmlDesignerResources.resx</DependentUpon>
    </Compile>
    <Compile Update="UI\ViewModels\PropertyWindow\Converters\ControlsXmlDesignerResources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>ControlsXmlDesignerResources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

</Project>
