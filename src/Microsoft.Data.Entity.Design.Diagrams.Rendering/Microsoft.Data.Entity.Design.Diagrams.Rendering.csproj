<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- net10.0, not net10.0-windows: PackAsTool rejects any TargetPlatformIdentifier, so the CLI downstream must
         be plain net10.0, and a net10.0 project cannot reference a net10.0-windows one (NU1201). The Windows
         Desktop assemblies the Modeling SDK needs come from the FrameworkReference below instead. This project
         only creates in-memory WinForms and WPF objects, so it needs no designer or XAML build support. -->
        <TargetFrameworks>net48;net10.0</TargetFrameworks>
        <!-- Directory.Build.props flattens output, which collides when multi-targeting. -->
        <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
        <RootNamespace>Microsoft.Data.Entity.Design.Diagrams.Rendering</RootNamespace>
        <AssemblyName>Microsoft.Data.Entity.Design.Diagrams.Rendering</AssemblyName>
        <NoWarn>$(NoWarn);VSTHRD010;VSSDK006;VSTHRD001;CS3014</NoWarn>
        <!-- Assembly properties -->
        <Title>Microsoft.Data.Entity.Design.Diagrams.Rendering</Title>
        <Description>Renders EDMX diagrams to SVG, Mermaid and raster images without a Visual Studio shell.</Description>
        <!-- Consumes DSL-generated types that are not CLS-compliant -->
        <CLSCompliant>false</CLSCompliant>
    </PropertyGroup>

    <ItemGroup>
        <Reference Include="System.Drawing" />
    </ItemGroup>

    <!-- PrivateAssets is required, not cosmetic: _CheckForTransitiveWindowsDesktopDependencies fails any consumer
       that is not -windows with NETSDK1136, but it only inspects TransitiveFrameworkReference. Keeping this from
       flowing lets the plain net10.0 CLI reference this project and declare its own. -->
    <ItemGroup Condition=" '$(TargetFramework)' == 'net10.0' ">
        <FrameworkReference Include="Microsoft.WindowsDesktop.App" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.VisualStudio.Modeling.Sdk" />
        <PackageReference Include="Microsoft.VisualStudio.Modeling.Sdk.Diagrams" />
        <PackageReference Include="Microsoft.VisualStudio.Modeling.Sdk.Diagrams.GraphObject" />
    </ItemGroup>

    <!-- Deliberately NOT referencing Microsoft.VisualStudio.Data.Entity.Package: that assembly owns PackageManager,
       VsUtils and everything else that requires a running shell. Keeping it out is what makes this project
       usable from a command line tool. -->
    <ItemGroup>
        <ProjectReference Include="..\Microsoft.Data.Entity.Design.Diagrams\Microsoft.Data.Entity.Design.Diagrams.csproj" />
        <ProjectReference Include="..\Microsoft.Data.Entity.Design.Edmx\Microsoft.Data.Entity.Design.Edmx.csproj" />
    </ItemGroup>

    <!-- SvgIconManager discovers these by manifest resource name, filtering on ".Export.Svg.Icons.". -->
    <ItemGroup>
        <EmbeddedResource Include="Export\Svg\Icons\*.svg" />
    </ItemGroup>

    <!-- InternalsVisibleTo for projects that need access to internal types -->
    <ItemGroup>
        <InternalsVisibleTo Include="Microsoft.VisualStudio.Data.Entity.Package, $(StrongNamePublicKey)" />
        <InternalsVisibleTo Include="Microsoft.Data.Entity.Design.Diagrams.Tools, $(StrongNamePublicKey)" />
        <InternalsVisibleTo Include="Microsoft.Data.Entity.Tests.Design.Diagrams.Rendering, $(StrongNamePublicKey)" />
    </ItemGroup>
</Project>
