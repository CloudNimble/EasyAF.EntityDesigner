<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
    <!-- Clears the net48 default from Directory.Build.props so TargetFrameworks below applies. -->
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net48;net10.0</TargetFrameworks>
    <RuntimeIdentifier></RuntimeIdentifier>
    <!-- Directory.Build.props flattens output, which collides when multi-targeting. -->
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
        <RootNamespace>Microsoft.Data.Entity.Tools</RootNamespace>
        <AssemblyName>Microsoft.Data.Entity.Tools</AssemblyName>
        <OutputType>Exe</OutputType>
        <NoWarn>$(NoWarn);CA1822;NU1701;NU1608;</NoWarn>
        <!-- Assembly properties -->
        <Title>Microsoft.Data.Entity.Tools</Title>
        <Description>Command line tool for rendering EDMX diagrams without Visual Studio.</Description>
        <CLSCompliant>false</CLSCompliant>
    </PropertyGroup>

    <!-- NOTE: This deliberately does NOT set PackAsTool. The renderer depends on the Visual Studio Modeling SDK,
         which only ships assemblies for .NET Framework 4.7.2, so this project is pinned to net48 by the whole
         dependency chain. `dotnet tool install` requires a .NET Core target, so this ships as a plain executable
         instead. Making it a real dotnet tool would mean a two process design: a net10 front end shelling out to a
         net48 worker. -->

    <ItemGroup>
        <PackageReference Include="McMaster.Extensions.Hosting.CommandLine" />
        <PackageReference Include="Svg.Skia" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
        <PackageReference Include="Microsoft.Extensions.Hosting" />
        <PackageReference Include="Microsoft.Extensions.Logging" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Microsoft.Data.Entity.Design.Renderer\Microsoft.Data.Entity.Design.Renderer.csproj" />
    </ItemGroup>

</Project>
