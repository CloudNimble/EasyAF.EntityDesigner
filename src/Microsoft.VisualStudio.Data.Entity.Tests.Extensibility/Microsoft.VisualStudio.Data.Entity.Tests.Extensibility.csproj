<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net48;net10.0</TargetFrameworks>
    <RuntimeIdentifier></RuntimeIdentifier>
    <!-- Directory.Build.props flattens output, which collides when multi-targeting. -->
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
    <RootNamespace>Microsoft.VisualStudio.Data.Entity.Tests.Extensibility</RootNamespace>
    <AssemblyName>Microsoft.VisualStudio.Data.Entity.Tests.Extensibility</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Microsoft.VisualStudio.Data.Entity.Extensibility\Microsoft.VisualStudio.Data.Entity.Extensibility.csproj" />
  </ItemGroup>

</Project>
