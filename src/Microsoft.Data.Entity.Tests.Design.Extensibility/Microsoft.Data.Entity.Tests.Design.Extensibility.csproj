<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Clears the net48 default from Directory.Build.props so TargetFrameworks below applies. -->
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net48;net10.0</TargetFrameworks>
    <RuntimeIdentifier></RuntimeIdentifier>
    <!-- Directory.Build.props flattens output, which collides when multi-targeting. -->
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
    <RootNamespace>Microsoft.Data.Entity.Tests.Design.Extensibility</RootNamespace>
    <AssemblyName>Microsoft.Data.Entity.Tests.Design.Extensibility</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Microsoft.Data.Entity.Design.Extensibility\Microsoft.Data.Entity.Design.Extensibility.csproj" />
  </ItemGroup>

</Project>
