    <ItemGroup>
        <ProjectReference Include="..\Microsoft.Data.Entity.Design.Edmx\Microsoft.Data.Entity.Design.Edmx.csproj" />
        <ProjectReference Include="..\Microsoft.Data.Entity.Design.XmlEngine\Microsoft.Data.Entity.Design.XmlEngine.csproj" />
        <ProjectReference Include="..\Microsoft.VisualStudio.Data.Entity.EdmxDesigner\Microsoft.VisualStudio.Data.Entity.EdmxDesigner.csproj" />
        <ProjectReference Include="..\Microsoft.VisualStudio.Data.Entity.XmlDesigner\Microsoft.VisualStudio.Data.Entity.XmlDesigner.csproj" />
        <ProjectReference Include="..\Microsoft.VisualStudio.TestTools.VsIdeTesting\Microsoft.VisualStudio.TestTools.VsIdeTesting.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- Allow test projects to access internal test helpers -->
        <InternalsVisibleTo Include="Microsoft.Data.Entity.Tests.Design, $(StrongNamePublicKey)" />
        <InternalsVisibleTo Include="Microsoft.Data.Entity.Tests.Design.Diagrams, $(StrongNamePublicKey)" />
        <InternalsVisibleTo Include="Microsoft.Data.Entity.Tests.Design.Edmx, $(StrongNamePublicKey)" />
        <InternalsVisibleTo Include="Microsoft.VisualStudio.Data.Entity.Tests.Package, $(StrongNamePublicKey)" />
