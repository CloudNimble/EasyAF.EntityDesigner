<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Microsoft.Data.Entity.Design.Renderer</RootNamespace>
    <AssemblyName>Microsoft.Data.Entity.Design.Renderer</AssemblyName>
    <NoWarn>$(NoWarn);VSTHRD010;VSSDK006;VSTHRD001;CS3014</NoWarn>
    <!-- Assembly properties -->
    <Title>Microsoft.Data.Entity.Design.Renderer</Title>
    <Description>Renders EDMX diagrams to SVG, Mermaid and raster images without a Visual Studio shell.</Description>
    <!-- Consumes DSL-generated types that are not CLS-compliant -->
    <CLSCompliant>false</CLSCompliant>
  </PropertyGroup>

  <!-- Deliberately NOT referencing Microsoft.Data.Entity.Design.Package: that assembly owns PackageManager,
       VsUtils and everything else that requires a running shell. Keeping it out is what makes this project
       usable from a command line tool. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.Modeling.Sdk" />
    <PackageReference Include="Microsoft.VisualStudio.Modeling.Sdk.Diagrams" />
    <PackageReference Include="Microsoft.VisualStudio.Modeling.Sdk.Diagrams.GraphObject" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Microsoft.Data.Entity.Design.Dsl\Microsoft.Data.Entity.Design.Dsl.csproj" />
    <ProjectReference Include="..\Microsoft.Data.Entity.Design.Model\Microsoft.Data.Entity.Design.Model.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <!-- SvgIconManager discovers these by manifest resource name, filtering on ".Export.Svg.Icons.". -->
  <ItemGroup>
    <EmbeddedResource Include="Export\Svg\Icons\*.svg" />
  </ItemGroup>

  <!-- InternalsVisibleTo for projects that need access to internal types -->
  <ItemGroup>
    <InternalsVisibleTo Include="Microsoft.Data.Entity.Design.Package, $(StrongNamePublicKey)" />
    <InternalsVisibleTo Include="Microsoft.Data.Entity.Tools, $(StrongNamePublicKey)" />
    <InternalsVisibleTo Include="Microsoft.Data.Entity.Tests.Design.Renderer, $(StrongNamePublicKey)" />
  </ItemGroup>
</Project>
